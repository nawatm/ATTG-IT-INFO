# Copy to .env; do not commit secrets.
DATABASE_URL="postgresql://attg:attg_local_only@localhost:5432/attg_info?schema=public"
AUTH_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
# Entra tenant UUID:object UUID of the first administrator (not an email).
BOOTSTRAP_ADMIN_SUBJECT=""
POSTGRES_PASSWORD="attg_local_only"
# Actual application origin (set HTTPS in production)
AUTH_URL="http://localhost:3000"

# Enable only after Entra app has Microsoft Graph User.Read.All application permission.
DIRECTORY_IMPORT_ENABLED="false"
